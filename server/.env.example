# =============================================================================
# Kredox AI - Environment template
# Copy to server/.env for local dev, OR set these in Render/Vercel dashboards.
# =============================================================================

# -- Core (REQUIRED on Render) -----------------------------------------------
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
REFRESH_JWT_SECRET=replace-with-a-second-random-string-at-least-32-characters

# Your Vercel frontend URL (no trailing slash)
DOMAIN=https://your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app
CORS_ALLOW_ALL=true

# First admin account (created automatically on deploy migrate)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=Kredox Admin
ALLOW_PUBLIC_REGISTRATION=true

# -- Frontend (REQUIRED on Vercel) -------------------------------------------
VITE_NODE_API=https://your-api.onrender.com
VITE_API_BASE_URL=https://your-api.onrender.com
VITE_TRANSCRIPT_WS_URL=wss://your-api.onrender.com
VITE_PYTHON_API=https://your-ml.onrender.com
VITE_ALLOW_PUBLIC_REGISTRATION=true

# -- Storage: Cloudinary (recommended) ---------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kredox-ai-demo

# -- LLM (recommended for reports) -------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -- STT (optional - browser fallback works without this) --------------------
DEEPGRAM_API_KEY=

# -- Video (optional - browser fallback works without this) --------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# -- Messaging (optional) ----------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -- Redis (optional) --------------------------------------------------------
REDIS_URL=

# -- ML service (optional) ---------------------------------------------------
ML_SERVICE_URL=https://your-ml.onrender.com

# -- Computer Vision (optional) ----------------------------------------------
CV_ANALYSIS_ENABLED=false
CV_PROVIDER=demo
AZURE_FACE_ENDPOINT=
AZURE_FACE_API_KEY=
AZURE_FACE_API_VERSION=v1.0

# -- Geo ---------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
