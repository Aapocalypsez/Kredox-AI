# -- Core -------------------------------------------------------------
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-32-plus-char-random-string
REFRESH_JWT_SECRET=replace-with-second-32-plus-char-random-string
DOMAIN=https://your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGINS=https://your-app.vercel.app,https://your-preview.vercel.app
CORS_ALLOW_ALL=true
ALLOW_PUBLIC_REGISTRATION=false

# -- Database (Supabase free tier) -----------------------------------
# Get from: supabase.com -> Project Settings -> Database -> Connection String

# -- Redis (Upstash free tier - optional) -----------------------------
# Leave blank to use in-memory fallback (OK for demo, not production)
REDIS_URL=

# -- Storage: Cloudinary ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- STT: Deepgram ----------------------------------------------------
DEEPGRAM_API_KEY=
TRANSCRIPT_WS_PORT=8080

# -- LLM: OpenAI ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -- Messaging (optional) --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# -- Video (Agora primary live RTC) ----------------------------------
# Set Agora keys to make live RTC the primary onboarding path.
# If left blank, the UI falls back to browser media for demos.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# -- Computer Vision --------------------------------------------------
# Demo fallback stays active unless CV_ANALYSIS_ENABLED=true and the provider credentials exist.
CV_ANALYSIS_ENABLED=false
CV_PROVIDER=demo
AZURE_FACE_ENDPOINT=
AZURE_FACE_API_KEY=
AZURE_FACE_API_VERSION=v1.0

# -- Geo --------------------------------------------------------------
# OpenStreetMap + Nominatim are used by default. Override only if self-hosting Nominatim.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# -- ML service -------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001

# -- Frontend env vars (for Vercel) ----------------------------------
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_TRANSCRIPT_WS_URL=wss://your-backend.onrender.com/ws
VITE_ALLOW_PUBLIC_REGISTRATION=false
