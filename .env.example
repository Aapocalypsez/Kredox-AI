NODE_ENV=development
PORT=5000

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis is optional for local/demo. Use Upstash/Render Redis if available.
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
REFRESH_JWT_SECRET=replace-with-a-second-long-random-secret

# Public app URLs
DOMAIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
VITE_NODE_API=http://localhost:5000
VITE_PYTHON_API=http://localhost:8001
VITE_API_BASE_URL=http://localhost:5000
VITE_TRANSCRIPT_WS_URL=ws://localhost:5000

# Optional messaging providers for campaign delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional live RTC. Leave blank for the upload-based demo flow.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Cloudinary video storage for Render demo deployments
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kredox-ai-demo

# STT. If blank/unavailable, frontend uses browser Web Speech fallback.
DEEPGRAM_API_KEY=
TRANSCRIPT_WS_PORT=5000

# OpenAI risk analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional geo verification
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Optional Python ML service. Render can host this separately, or leave local for demos.
ML_API_URL=http://localhost:8001
ML_SERVICE_URL=http://localhost:8001

# Optional transcript search. Leave blank to use PostgreSQL fallback where implemented.
ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TRANSCRIPT_INDEX=transcripts
