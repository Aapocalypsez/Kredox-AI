# ── Core ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-32-plus-char-random-string
REFRESH_JWT_SECRET=replace-with-second-32-plus-char-random-string
DOMAIN=https://your-app.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app

# ── Database (Supabase free tier) ────────────────────────────
# Get from: supabase.com → Project Settings → Database → Connection String

# ── Redis (Upstash free tier — optional) ─────────────────────
# Get from: upstash.com → Create Database → REST → copy REDIS_URL
# Leave blank to use in-memory fallback (OK for demo, not production)
REDIS_URL=

# ── Storage: Cloudinary (free 25GB) ──────────────────────────
# Get from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── STT: Deepgram ($200 free credit) ─────────────────────────
# Get from: deepgram.com → API Keys
DEEPGRAM_API_KEY=
TRANSCRIPT_WS_PORT=8080

# ── LLM: OpenAI ──────────────────────────────────────────────
# Using gpt-4o-mini by default (cheapest, ~$0.15/1M tokens)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Messaging (optional) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Video (Agora — optional for live RTC) ────────────────────
# Leave blank to use upload-based demo flow
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Geo (optional) ───────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── ML service ───────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ── Frontend env vars (for Vercel) ───────────────────────────
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_TRANSCRIPT_WS_URL=wss://your-backend.onrender.com/ws
VITE_GOOGLE_MAPS_API_KEY=
